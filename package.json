{
  "name": "parque-cidade-viva",
  "private": true,
  "version": "1.0.0",
  "description": "Maquete digital conceitual 3D (projeto acadêmico SENAC) — não é BIM, projeto executivo nem gêmeo digital.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "e2e": "playwright test --trace off",
    "desktop": "npm run build && electron .",
    "dist:desktop": "npm run build && electron-builder --linux AppImage --win portable zip --publish never"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "main": "electron/main.cjs",
  "author": {
    "name": "Projeto acadêmico SENAC — Parque Cidade Viva"
  },
  "build": {
    "appId": "br.senac.parquecidadeviva",
    "productName": "Parque Cidade Viva",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "artifactName": "ParqueCidadeViva-${version}-linux-${arch}.${ext}"
    },
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "signAndEditExecutable": false,
      "artifactName": "ParqueCidadeViva-${version}-windows-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "ParqueCidadeViva-${version}-windows-portatil.${ext}"
    }
  },
  "desktopName": "parque-cidade-viva.desktop"
}
